        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alapértelmezés szerint a telefon nyelve. Itt bármikor átállíthatod."
          }
        }
      }
    },
    "Az e-mailes feliratkozás ehhez a verzióhoz nincs bekötve. A gyerekek adatai, képei és játékhaladása nem kerül semmilyen levelezőlistára." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Email signup is not connected in this version. Children’s names, photos, and gameplay are never added to a mailing list."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az e-mailes feliratkozás ehhez a verzióhoz nincs bekötve. A gyerekek adatai, képei és játékhaladása nem kerül semmilyen levelezőlistára."
