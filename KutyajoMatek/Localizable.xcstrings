    },
    "A „Haladás törlése” csak az eredményeket törli. A „Profil törlése” az egész profilt eltávolítja." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Reset Progress” only clears results. “Delete Profile” removes the whole profile."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A „Haladás törlése” csak az eredményeket törli. A „Profil törlése” az egész profilt eltávolítja."
          }
        }
      }
    },
    "A hibátlan kör után itt jelenik meg az első kutyusod." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After a perfect round, your first puppy appears here."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hibátlan kör után itt jelenik meg az első kutyusod."
          }
        }
      }
    },
    "A játék, a profilok és a kutyagyűjtemény teljesen offline működik. Nincs bejelentkezés." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game, profiles, and dog collection work fully offline. No sign-in."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A játék, a profilok és a kutyagyűjtemény teljesen offline működik. Nincs bejelentkezés."
          }
        }
      }
    },
    "A teljes kutyagyűjteményt megszerezted. Ez óriási teljesítmény!" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You collected every puppy. What an achievement!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A teljes kutyagyűjteményt megszerezted. Ez óriási teljesítmény!"
          }
        }
      }
    },
    "Adj meg egy nevet. A kutyusok és a haladás külön mentődnek." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a name. Dogs and progress are saved separately for each profile."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj meg egy nevet. A kutyusok és a haladás külön mentődnek."
          }
        }
      }
    },
    "Alapértelmezés szerint a telefon nyelve. Itt bármikor átállíthatod." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defaults to your phone language. You can change it here anytime."
