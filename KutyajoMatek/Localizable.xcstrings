    "%@ összes kutyusa, eredménye és szintje törlődik. A név és a profilkép megmarad." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All of %@’s dogs, scores, and levels will be cleared. The name and photo stay."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ összes kutyusa, eredménye és szintje törlődik. A név és a profilkép megmarad."
          }
        }
      }
    },
    "%@ profilja, kutyusai, eredményei és a mentett profilkép véglegesen törlődnek. Ez a többi profilt nem érinti." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@’s profile, dogs, scores, and saved photo will be permanently deleted. Other profiles are not affected."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ profilja, kutyusai, eredményei és a mentett profilkép véglegesen törlődnek. Ez a többi profilt nem érinti."
          }
        }
      }
    },
